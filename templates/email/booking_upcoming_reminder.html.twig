<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Check-in amanhã</title>
</head>
<body style="font-family: Georgia, 'Times New Roman', serif; line-height: 1.6; color: #1a3a2e; max-width: 560px; margin: 0 auto; padding: 24px;">
    <h1 style="font-size: 1.35rem; margin: 0 0 1rem;">Check-in amanhã</h1>

    <p style="margin: 0 0 1rem;">
        A reserva de <strong>{{ booking.guestName }}</strong> tem check-in amanhã.
    </p>

    <table style="width: 100%; border-collapse: collapse; margin: 0 0 1.5rem;">
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">Check-in</td>
            <td style="padding: .35rem 0;">{{ booking.checkIn|date('d/m/Y') }}</td>
        </tr>
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">Check-out</td>
            <td style="padding: .35rem 0;">{{ booking.checkOut|date('d/m/Y') }}</td>
        </tr>
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">Hóspedes</td>
            <td style="padding: .35rem 0;">{{ booking.guests }}</td>
        </tr>
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">Origem</td>
            <td style="padding: .35rem 0;">{{ booking.source }}</td>
        </tr>
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">Código</td>
            <td style="padding: .35rem 0;">{{ booking.accessCode }}</td>
        </tr>
        {% if booking.guestWhatsapp %}
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">WhatsApp</td>
            <td style="padding: .35rem 0;">{{ booking.guestWhatsapp }}</td>
        </tr>
        {% endif %}
        {% if booking.notes %}
        <tr>
            <td style="padding: .35rem 0; opacity: .75; vertical-align: top;">Notas</td>
            <td style="padding: .35rem 0;">{{ booking.notes|nl2br }}</td>
        </tr>
        {% endif %}
    </table>

    <p style="margin: 0;">
        <a href="{{ bookingUrl }}" style="display: inline-block; background: #1a3a2e; color: #fff; text-decoration: none; padding: .75rem 1.25rem; border-radius: 999px;">
            Ver reserva no admin
        </a>
    </p>
</body>
</html>
