<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Erro no site do hóspede</title>
</head>
<body style="font-family: Georgia, serif; color: #1a3a2e; line-height: 1.6; max-width: 560px; margin: 0 auto; padding: 24px;">
    <h1 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Erro no site do hóspede</h1>
    <p style="margin-top: 0; color: #555;">Um hóspede encontrou um problema na página de concierge.</p>

    <p><strong>Mensagem:</strong> {{ error.message }}</p>
    <p><strong>Origem:</strong> {{ error.source == 'client' ? 'Browser do hóspede' : 'Servidor' }}</p>
    <p><strong>Rota:</strong> {{ error.route }}</p>
    {% if error.accessCode %}
        <p><strong>Código:</strong> {{ error.accessCode }}</p>
    {% endif %}
    {% if booking %}
        <p><strong>Hóspede:</strong> {{ booking.guestName }}</p>
    {% endif %}
    {% if error.httpStatus %}
        <p><strong>HTTP:</strong> {{ error.httpStatus }}</p>
    {% endif %}
    <p><strong>Quando:</strong> {{ error.createdAt|date('d/m/Y H:i') }}</p>

    <p style="margin-top: 1.5rem;">
        <a href="{{ dashboardUrl }}" style="color: #1a3a2e; font-weight: 600;">Abrir painel admin →</a>
    </p>
</body>
</html>
