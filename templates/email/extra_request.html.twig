<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Nova solicitação de extra</title>
</head>
<body style="font-family: Georgia, 'Times New Roman', serif; line-height: 1.6; color: #1a3a2e; max-width: 560px; margin: 0 auto; padding: 24px;">
    <h1 style="font-size: 1.35rem; margin: 0 0 1rem;">Nova solicitação de extra</h1>

    <p style="margin: 0 0 1rem;">
        <strong>{{ booking.guestName }}</strong> solicitou um extra pela concierge digital.
    </p>

    <table style="width: 100%; border-collapse: collapse; margin: 0 0 1.5rem;">
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">Extra</td>
            <td style="padding: .35rem 0;"><strong>{{ extra.namePt }}</strong></td>
        </tr>
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">Quantidade</td>
            <td style="padding: .35rem 0;">{{ bookingExtra.quantity }}</td>
        </tr>
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">Total</td>
            <td style="padding: .35rem 0;">{{ totalFormatted }}</td>
        </tr>
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">Estadia</td>
            <td style="padding: .35rem 0;">{{ booking.checkIn|date('d/m/Y') }} — {{ booking.checkOut|date('d/m/Y') }}</td>
        </tr>
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">Código</td>
            <td style="padding: .35rem 0;">{{ booking.accessCode }}</td>
        </tr>
        {% if bookingExtra.notes %}
        <tr>
            <td style="padding: .35rem 0; opacity: .75; vertical-align: top;">Observações</td>
            <td style="padding: .35rem 0;">{{ bookingExtra.notes }}</td>
        </tr>
        {% endif %}
    </table>

    <p style="margin: 0;">
        <a href="{{ bookingUrl }}" style="display: inline-block; background: #1a3a2e; color: #fff; text-decoration: none; padding: .75rem 1.25rem; border-radius: 999px;">
            Ver reserva no admin
        </a>
    </p>
</body>
</html>
