<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>{% if updated %}Horário de chegada actualizado{% else %}Horário de chegada informado{% endif %}</title>
</head>
<body style="font-family: Georgia, 'Times New Roman', serif; line-height: 1.6; color: #1a3a2e; max-width: 560px; margin: 0 auto; padding: 24px;">
    <h1 style="font-size: 1.35rem; margin: 0 0 1rem;">
        {% if updated %}Horário de chegada actualizado{% else %}Horário de chegada informado{% endif %}
    </h1>

    <p style="margin: 0 0 1rem;">
        <strong>{{ booking.guestName }}</strong>
        {% if updated %}actualizou{% else %}informou{% endif %}
        o horário previsto de chegada pela concierge digital.
    </p>

    <table style="width: 100%; border-collapse: collapse; margin: 0 0 1.5rem;">
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">Horário previsto</td>
            <td style="padding: .35rem 0;"><strong>{{ booking.plannedArrivalTime }}</strong></td>
        </tr>
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">Check-in</td>
            <td style="padding: .35rem 0;">{{ booking.checkIn|date('d/m/Y') }}</td>
        </tr>
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">Estadia</td>
            <td style="padding: .35rem 0;">{{ booking.checkIn|date('d/m/Y') }} — {{ booking.checkOut|date('d/m/Y') }}</td>
        </tr>
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">Código</td>
            <td style="padding: .35rem 0;">{{ booking.accessCode }}</td>
        </tr>
        {% if booking.plannedArrivalSubmittedAt %}
        <tr>
            <td style="padding: .35rem 0; opacity: .75;">Informado em</td>
            <td style="padding: .35rem 0;">{{ booking.plannedArrivalSubmittedAt|date('d/m/Y H:i') }}</td>
        </tr>
        {% endif %}
    </table>

    <p style="margin: 0;">
        <a href="{{ bookingUrl }}" style="display: inline-block; background: #1a3a2e; color: #fff; text-decoration: none; padding: .75rem 1.25rem; border-radius: 999px;">
            Ver reserva no admin
        </a>
    </p>
</body>
</html>
