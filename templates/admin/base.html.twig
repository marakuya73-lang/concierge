<!DOCTYPE html>
<html lang="pt" data-turbo="false">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#1a3a2e">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="turbo-visit-control" content="reload">
    <link rel="manifest" href="/admin-manifest.json">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <title>{% block title %}Admin{% endblock %} | Domo Xangô</title>
    <link rel="icon" href="/images/favicon.png">
    <style>
        /* Inline admin mobile fixes — load with HTML so PWA updates work without stale CSS cache */
        [data-admin-notifications-target="testBtn"] { display: none !important; }
        @media (max-width: 768px) {
            body.admin-app { overflow-x: hidden; max-width: 100%; }
            .admin-layout { display: block; overflow-x: hidden; max-width: 100%; }
            .admin-shell { width: 100%; max-width: 100%; min-width: 0; overflow-x: hidden; }
            .admin-main {
                padding: 1rem;
                padding-left: max(1rem, env(safe-area-inset-left));
                padding-right: max(1rem, env(safe-area-inset-right));
                padding-bottom: max(1rem, env(safe-area-inset-bottom));
                overflow-x: hidden;
                max-width: 100%;
                min-width: 0;
            }
            .admin-content { width: 100%; max-width: 100%; min-width: 0; }
            .admin-topbar { display: flex !important; }
            .admin-sidebar {
                position: fixed;
                inset: 0 auto 0 0;
                z-index: 50;
                width: min(280px, 85vw);
                transform: translateX(-100%);
            }
            .admin-layout.admin-nav-open .admin-sidebar { transform: translateX(0); }
            .admin-header { flex-direction: column; align-items: stretch; gap: .85rem; }
            .admin-header-actions { width: 100%; flex-direction: column; }
            .admin-header-actions .btn,
            .admin-header-actions form,
            .admin-header-actions form .btn { width: 100%; }
            .admin-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
            .admin-stat { padding: .85rem .75rem; min-width: 0; }
            .admin-stat-value { font-size: 1.5rem; }
            .admin-stat-label { font-size: .6rem; line-height: 1.25; letter-spacing: .04em; }
            .admin-section { padding: 1rem; overflow: hidden; }
            .admin-dashboard-grid { grid-template-columns: 1fr; }
            .admin-calendar { width: 100%; min-width: 0; overflow-x: auto; -webkit-overflow-scrolling: touch; }
            .admin-calendar-head,
            .admin-calendar-grid { grid-template-columns: repeat(7, minmax(0, 1fr)); gap: .2rem; min-width: 0; }
            .admin-calendar-head span { font-size: 0; }
            .admin-calendar-head span::first-letter { font-size: .65rem; }
            .admin-calendar-day,
            .admin-calendar-empty { min-height: 3rem; }
            .admin-table-wrap { overflow-x: auto; max-width: 100%; -webkit-overflow-scrolling: touch; }
            .admin-notify-bar { flex-direction: column; align-items: stretch; gap: .5rem; }
            .admin-list-item { flex-direction: column; align-items: flex-start; }
            .admin-list-item span { white-space: normal; }
        }
    </style>
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{% block importmap %}{{ importmap('app') }}{% endblock %}{% endblock %}
</head>
<body class="admin-app" data-turbo="false">
<div class="admin-layout" data-controller="admin-nav admin-notifications">
    <div class="admin-nav-backdrop" data-action="click->admin-nav#close"></div>
    <aside class="admin-sidebar" id="admin-sidebar">
        <div class="admin-sidebar-brand">
            <img src="/images/logo.png" alt="Domo Xangô" class="site-logo site-logo-sm">
            <h1>Domo Xangô</h1>
        </div>
        <nav class="admin-nav" data-action="click->admin-nav#closeOnNav">
            <a href="{{ path('admin_dashboard') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_dashboard' ? 'active' : '' }}">Dashboard</a>
            <a href="{{ path('admin_bookings') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_booking' ? 'active' : '' }}">Reservas</a>
            <a href="{{ path('admin_extras') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_extra' ? 'active' : '' }}">Extras</a>
            <a href="{{ path('admin_property') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_property' ? 'active' : '' }}">Propriedade</a>
            <div class="admin-nav-divider"></div>
            <a href="{{ path('guest_home') }}" target="_blank">Ver site ↗</a>
            <a href="{{ path('admin_logout') }}">Sair</a>
        </nav>
    </aside>
    <div class="admin-shell">
        <header class="admin-topbar">
            <button
                type="button"
                class="admin-menu-toggle"
                aria-label="Abrir menu"
                aria-expanded="false"
                aria-controls="admin-sidebar"
                data-admin-nav-target="toggle"
                data-action="admin-nav#toggle"
            >
                <span class="admin-menu-icon" aria-hidden="true"></span>
            </button>
            <div class="admin-topbar-brand">
                <img src="/images/logo.png" alt="" class="site-logo site-logo-sm" aria-hidden="true">
                <span>Domo Xangô</span>
            </div>
        </header>
        <div class="admin-notify-prompt" data-admin-notifications-target="prompt" hidden>
            <div class="admin-notify-prompt-copy">
                <p data-admin-notifications-target="promptText">Receba alertas de extras no telemóvel (som, vibração e notificações).</p>
            </div>
            <div class="admin-notify-prompt-actions">
                <button type="button" class="btn btn-primary btn-sm" data-admin-notifications-target="enableBtn" data-action="click->admin-notifications#enableNotifications">Ativar notificações</button>
            </div>
        </div>
        <div class="admin-notify-bar">
            <p class="admin-notify-status" data-admin-notifications-target="status">A verificar notificações…</p>
        </div>
        <div class="admin-alert-banner" data-admin-notifications-target="banner" hidden></div>
        <main class="admin-main">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block admin %}{% endblock %}
        </main>
    </div>
</div>
<script>
    document.querySelector('[data-admin-notifications-target="testBtn"]')?.remove();
</script>
</body>
</html>
