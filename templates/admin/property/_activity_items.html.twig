{% import 'admin/_csrf.html.twig' as csrf %}

<section class="admin-section" id="activities-content">
    <div class="admin-section-header">
        <h3 class="admin-section-title">Atividades</h3>
        <p class="admin-section-desc">Experiências e sugestões exibidas na aba Atividades na estadia do hóspede.</p>
    </div>

    <article class="admin-guide-item admin-guide-item--intro">
        <div class="admin-guide-item-header">
            <h4 class="admin-guide-item-title">Introdução</h4>
            <span class="admin-guide-item-type">texto</span>
        </div>
        <form method="post" action="{{ path('admin_activity_items_intro_update') }}" class="form-grid admin-guide-form admin-guide-form--full">
            {{ csrf.csrf() }}
            <div class="form-row-2">
                <div class="form-group">
                    <label>Introdução (PT)</label>
                    <textarea name="activitiesIntroPt" rows="2">{{ property.activitiesIntroPt }}</textarea>
                </div>
                <div class="form-group">
                    <label>Introdução (EN)</label>
                    <textarea name="activitiesIntroEn" rows="2">{{ property.activitiesIntroEn }}</textarea>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-accent btn-sm">Salvar introdução</button>
            </div>
        </form>
    </article>

    <div class="admin-guide-list">
        {% for item in activityItems %}
            <article class="admin-guide-item">
                <div class="admin-guide-item-header">
                    <h4 class="admin-guide-item-title">{{ item.icon }} {{ item.titlePt ?: ('Atividade #' ~ item.sortOrder) }}</h4>
                    <span class="admin-guide-item-type">atividade</span>
                </div>

                <form method="post" action="{{ path('admin_activity_item_update', {id: item.id}) }}" class="form-grid admin-guide-form admin-guide-form--full">
                    {{ csrf.csrf() }}
                    <div class="form-row-2">
                        <div class="form-group">
                            <label>Ícone (emoji)</label>
                            <input type="text" name="icon" value="{{ item.icon }}" maxlength="8" style="max-width:6rem">
                        </div>
                        <div class="form-group admin-guide-active">
                            <label class="admin-checkbox">
                                <input type="checkbox" name="active" value="1" {{ item.active ? 'checked' : '' }}>
                                Visível para hóspedes
                            </label>
                        </div>
                    </div>
                    <div class="form-row-2">
                        <div class="form-group">
                            <label>Título (PT)</label>
                            <input type="text" name="titlePt" value="{{ item.titlePt }}">
                        </div>
                        <div class="form-group">
                            <label>Título (EN)</label>
                            <input type="text" name="titleEn" value="{{ item.titleEn }}">
                        </div>
                    </div>
                    <div class="form-row-2">
                        <div class="form-group">
                            <label>Texto (PT)</label>
                            <textarea name="bodyPt" rows="4">{{ item.bodyPt }}</textarea>
                        </div>
                        <div class="form-group">
                            <label>Texto (EN)</label>
                            <textarea name="bodyEn" rows="4">{{ item.bodyEn }}</textarea>
                        </div>
                    </div>
                    <div class="form-row-2">
                        <div class="form-group">
                            <label>Link principal</label>
                            <input type="url" name="linkUrl" value="{{ item.linkUrl }}" placeholder="Maps, site ou WhatsApp">
                        </div>
                        <div class="form-group">
                            <label>Link secundário (opcional)</label>
                            <input type="url" name="linkUrl2" value="{{ item.linkUrl2 }}" placeholder="Segundo link, ex. outra feira">
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-accent btn-sm">Salvar atividade</button>
                    </div>
                </form>
            </article>
        {% else %}
            <p style="color:var(--muted-foreground);font-size:.875rem;margin:0">Nenhuma atividade cadastrada. Execute as migrations.</p>
        {% endfor %}
    </div>
</section>
