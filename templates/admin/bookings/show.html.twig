{% extends 'admin/base.html.twig' %}
{% import 'admin/_csrf.html.twig' as csrf %}
{% block title %}Reserva: {{ booking.guestName }}{% endblock %}

{% block admin %}
<div class="admin-content">
    <div class="admin-header">
        <div>
            <a href="{{ path('admin_bookings') }}" class="admin-back-link">← Reservas</a>
            <h2 class="admin-page-title" style="margin:.35rem 0 0">{{ booking.guestName }}</h2>
            <p class="admin-page-desc">
                {{ booking.guestEmail }}
                {% if booking.guestWhatsapp %}
                    · {{ booking.guestWhatsapp }}
                {% endif %}
            </p>
        </div>
        <div class="admin-header-actions">
            {% if not isEditing %}
                <a href="{{ path('admin_booking_show', {id: booking.id, edit: 1}) }}" class="btn btn-outline btn-sm">Editar</a>
            {% endif %}
            <a href="#follow-ups" class="btn btn-accent btn-sm">WhatsApp follow-up</a>
            <button type="button" class="btn btn-accent btn-sm" data-copy-target="#guest-welcome-message">Copiar mensagem</button>
            <form method="post" action="{{ path('admin_booking_regenerate_code', {id: booking.id}) }}">
                {{ csrf.csrf() }}
                <button type="submit" class="btn btn-outline btn-sm">↻ Novo código</button>
            </form>
            <form method="post" action="{{ path('admin_booking_delete', {id: booking.id}) }}" onsubmit="return confirm('Remover reserva?')">
                {{ csrf.csrf() }}
                <button type="submit" class="btn btn-outline btn-sm" style="color:var(--destructive)">Remover</button>
            </form>
        </div>
    </div>

    {% if booking.needsGuestInfo %}
        <div class="admin-notice">
            Reserva Site importada do calendário Airbnb. Preencha o nome e o valor da estadia, o código <strong>{{ booking.accessCode }}</strong> já pode ser enviado ao hóspede.
        </div>
    {% endif %}

    {% set rajaaramBusy = booking.rajaaramCalendarConflictsOf('busy') %}
    {% set rajaaramDrift = booking.rajaaramCalendarConflictsOf('drift') %}

    {% if rajaaramDrift|length > 0 %}
        <div class="admin-notice">
            <p class="admin-notice-title">O calendário Rajaaram é a fonte de verdade</p>
            <p>
                A reserva tem conteúdo diferente do calendário Rajaaram.
                O calendário não foi alterado. Actualize a reserva com o que está lá, ou confirme que quer escrever esta alteração no calendário Rajaaram.
            </p>
            <ul class="admin-notice-compare">
                {% for conflict in rajaaramDrift %}
                    <li>
                        <p>{{ conflict.message }}</p>
                        <p>
                            <strong>Calendário:</strong>
                            {{ conflict.calendarSummary|default('—') }}
                            {% if conflict.calendarGuest %} · {{ conflict.calendarGuest }}{% endif %}
                            {% if conflict.calendarDate %} · {{ conflict.calendarDate }} {{ conflict.calendarTime }}{% endif %}
                        </p>
                        <p>
                            <strong>Reserva:</strong>
                            {% if conflict.savedTherapy or conflict.savedGuest or conflict.savedDate %}
                                {{ conflict.savedTherapy|default('Terapia') }}
                                {% if conflict.savedGuest %} · {{ conflict.savedGuest }}{% endif %}
                                {% if conflict.savedDate %} · {{ conflict.savedDate }} {{ conflict.savedTime }}{% endif %}
                            {% else %}
                                sessão removida desta reserva
                            {% endif %}
                        </p>
                    </li>
                {% endfor %}
            </ul>
            <div class="admin-notice-actions">
                <form method="post" action="{{ path('admin_booking_pull_rajaaram_calendar', {id: booking.id}) }}">
                    {{ csrf.csrf() }}
                    <button type="submit" class="btn btn-primary btn-sm">Usar o calendário Rajaaram</button>
                </form>
                <form method="post" action="{{ path('admin_booking_force_rajaaram_calendar', {id: booking.id}) }}">
                    {{ csrf.csrf() }}
                    <button type="submit" class="btn btn-outline btn-sm">Actualizar o calendário Rajaaram</button>
                </form>
            </div>
        </div>
    {% endif %}

    {% if rajaaramBusy|length > 0 %}
        <div class="admin-notice admin-notice--error">
            <p class="admin-notice-title">Horário ocupado no calendário Rajaaram</p>
            {% for conflict in rajaaramBusy %}
                <p>{{ conflict.message }}</p>
            {% endfor %}
            <p>
                A terapia ficou na reserva e o hóspede já a vê no concierge.
                O evento no calendário Rajaaram não foi criado. Criar mesmo assim?
            </p>
            <div class="admin-notice-actions">
                <form method="post" action="{{ path('admin_booking_force_rajaaram_calendar', {id: booking.id}) }}">
                    {{ csrf.csrf() }}
                    <button type="submit" class="btn btn-primary btn-sm">Criar no calendário Rajaaram</button>
                </form>
                {% if not isEditing %}
                    <a href="{{ path('admin_booking_show', {id: booking.id, edit: 1}) }}" class="btn btn-outline btn-sm">Escolher outro horário</a>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {% if rajaaramSuggestions|default([])|length > 0 %}
        <div class="admin-notice">
            <p class="admin-notice-title">Terapia no calendário Rajaaram</p>
            <p>
                Encontrámos {{ rajaaramSuggestions|length == 1 ? 'uma sessão' : rajaaramSuggestions|length ~ ' sessões' }}
                durante esta estadia. Se adicionar, a reserva passa a origem Rajaaram e o hóspede vê a jornada no concierge.
            </p>
            <form method="post" action="{{ path('admin_booking_apply_rajaaram_suggestion', {id: booking.id}) }}" class="admin-suggestion-form">
                {{ csrf.csrf() }}
                <ul class="admin-suggestion-list">
                    {% for suggestion in rajaaramSuggestions %}
                        <li>
                            <label class="admin-suggestion-item">
                                <input type="checkbox" name="eventIds[]" value="{{ suggestion.eventId }}" checked>
                                <span>
                                    <strong>{{ suggestion.therapyLabel }}</strong>
                                    · {{ suggestion.date }} {{ suggestion.time }}
                                    {% if suggestion.guest %} · {{ suggestion.guest }}{% endif %}
                                    {% if suggestion.nameMatch %}
                                        <em class="admin-suggestion-match">coincide com o nome da reserva</em>
                                    {% endif %}
                                </span>
                            </label>
                        </li>
                    {% endfor %}
                </ul>
                <div class="admin-notice-actions">
                    <button type="submit" class="btn btn-primary btn-sm">Adicionar à reserva</button>
                    <button type="submit" class="btn btn-outline btn-sm" form="rajaaram-suggestion-dismiss">Ignorar</button>
                </div>
            </form>
            <form id="rajaaram-suggestion-dismiss" method="post" action="{{ path('admin_booking_dismiss_rajaaram_suggestion', {id: booking.id}) }}">
                {{ csrf.csrf() }}
                {% for suggestion in rajaaramSuggestions %}
                    <input type="hidden" name="eventIds[]" value="{{ suggestion.eventId }}">
                {% endfor %}
            </form>
        </div>
    {% endif %}

    {% if isEditing %}
        {{ form_start(form, {attr: {
            class: 'admin-booking-edit-form',
            'data-controller': 'booking-form',
            'data-action': 'change->booking-form#sync',
            'data-booking-form-rajaaram-value': constant('App\\Entity\\Booking::SOURCE_RAJAARAM'),
        }}) }}
    {% endif %}

    <div class="admin-access-code">
        <p class="admin-kicker admin-kicker--light">Código de acesso</p>
        {% if isEditing %}
                <div class="admin-access-code-row">
                    <div class="form-group admin-access-code-field">
                        {{ form_label(form.accessCode) }}
                        {{ form_widget(form.accessCode) }}
                        {{ form_errors(form.accessCode) }}
                    </div>
                    <button type="button" class="btn btn-outline-light btn-sm" data-copy-target="#guest-welcome-message">Copiar mensagem</button>
                </div>
                <p class="admin-page-desc" style="margin:.5rem 0 0">5 caracteres, partilhe com o hóspede para acesso ao concierge privado.</p>
        {% else %}
            <div class="admin-access-code-row">
                <span class="admin-access-code-value">{{ booking.accessCode }}</span>
                <div style="display:flex;gap:.5rem;flex-wrap:wrap">
                    <a href="{{ path('admin_booking_show', {id: booking.id, edit: 1}) }}" class="btn btn-outline-light btn-sm">Editar</a>
                    <button type="button" class="btn btn-outline-light btn-sm" data-copy-code="{{ booking.accessCode }}">Copiar código</button>
                    <button type="button" class="btn btn-outline-light btn-sm" data-copy-target="#guest-welcome-message">Copiar mensagem</button>
                </div>
            </div>
            <p class="admin-page-desc" style="margin:.5rem 0 0">Compartilhe com o hóspede para acesso ao concierge privado.</p>
        {% endif %}
    </div>

    <div class="admin-detail-grid">
        <section class="admin-section">
            {% if isEditing %}
                <div class="admin-section-header">
                    <h3 class="admin-section-title">Editando reserva</h3>
                </div>
                    <div class="form-grid">
                    <div class="form-row-2">
                        {{ form_row(form.guestName) }}
                        <div class="form-group">
                            {{ form_label(form.guestWhatsapp) }}
                            {{ form_widget(form.guestWhatsapp) }}
                            {{ form_errors(form.guestWhatsapp) }}
                            {{ form_help(form.guestWhatsapp) }}
                        </div>
                    </div>
                    <div class="form-row-2">
                        <div class="form-group">{{ form_label(form.checkIn) }}{{ form_widget(form.checkIn) }}</div>
                        <div class="form-group">{{ form_label(form.checkOut) }}{{ form_widget(form.checkOut) }}</div>
                    </div>
                    <div class="form-row-2">
                        <div class="form-group">{{ form_label(form.guests) }}{{ form_widget(form.guests) }}</div>
                        <div class="form-group">{{ form_label(form.stayPrice) }}{{ form_widget(form.stayPrice) }}</div>
                    </div>
                    {% include 'admin/bookings/_extra_guests.html.twig' %}
                    <div class="form-row-2">
                        <div class="form-group">
                            {{ form_label(form.guestLocale) }}
                            {{ form_widget(form.guestLocale) }}
                            {{ form_errors(form.guestLocale) }}
                        </div>
                    </div>
                    <div class="form-row-2">
                        <div class="form-group">{{ form_label(form.source) }}{{ form_widget(form.source) }}</div>
                        <div class="form-group">{{ form_label(form.status) }}{{ form_widget(form.status) }}</div>
                    </div>
                    {% include 'admin/bookings/_rajaaram_fields.html.twig' %}
                    <div class="form-group">{{ form_label(form.notes) }}{{ form_widget(form.notes) }}</div>
                    <div class="form-actions">
                        <a href="{{ path('admin_booking_show', {id: booking.id}) }}" class="btn btn-outline">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Salvar alterações</button>
                    </div>
                </div>
            {% else %}
                <div class="admin-detail-rows">
                    <div class="admin-detail-row">
                        <span>WhatsApp</span>
                        <strong>
                            {% if booking.guestWhatsappUrl %}
                                <a href="{{ booking.guestWhatsappUrl }}" target="_blank" rel="noopener noreferrer">{{ booking.guestWhatsapp }}</a>
                            {% elseif booking.guestWhatsapp %}
                                {{ booking.guestWhatsapp }}
                            {% else %}
                                -
                            {% endif %}
                        </strong>
                    </div>
                    <div class="admin-detail-row">
                        <span>Check-in</span>
                        <strong>{{ booking.checkIn|date('d/m/Y') }}</strong>
                    </div>
                    <div class="admin-detail-row">
                        <span>Horário previsto de chegada</span>
                        <strong class="admin-detail-row-actions admin-planned-arrival-actions">
                            {% if booking.plannedArrivalSubmittedAt %}
                                <span class="admin-muted">{{ booking.plannedArrivalSubmittedAt|date('d/m/Y H:i') }}</span>
                            {% endif %}
                            <form method="post" action="{{ path('admin_booking_planned_arrival', {id: booking.id}) }}" class="admin-planned-arrival-form">
                                {{ csrf.csrf() }}
                                <input type="time" name="time" value="{{ booking.plannedArrivalTime ?? '' }}" min="{{ property.checkInTime }}" required>
                                <button type="submit" class="btn btn-sm btn-accent">Guardar</button>
                                {% if booking.plannedArrivalTime %}
                                    <button type="submit" name="action" value="clear" class="btn btn-sm btn-outline">Limpar</button>
                                {% endif %}
                            </form>
                        </strong>
                    </div>
                    <div class="admin-detail-row">
                        <span>Self check-in</span>
                        <strong class="admin-detail-row-actions">
                            {% if booking.selfCheckInRequested %}
                                <span class="status-pill status-confirmed">Activo</span>
                                {% if booking.selfCheckInRequestedAt %}
                                    <span class="admin-muted">{{ booking.selfCheckInRequestedAt|date('d/m/Y H:i') }}</span>
                                {% endif %}
                            {% else %}
                                <span class="admin-muted">Não activo</span>
                            {% endif %}
                            <form method="post" action="{{ path('admin_booking_toggle_self_checkin', {id: booking.id}) }}">
                                {{ csrf.csrf() }}
                                <button type="submit" class="btn btn-sm {% if booking.selfCheckInRequested %}btn-outline{% else %}btn-accent{% endif %}">
                                    {% if booking.selfCheckInRequested %}Desactivar{% else %}Activar{% endif %}
                                </button>
                            </form>
                        </strong>
                    </div>
                    <div class="admin-detail-row">
                        <span>Check-out</span>
                        <strong>{{ booking.checkOut|date('d/m/Y') }}</strong>
                    </div>
                    <div class="admin-detail-row">
                        <span>Hóspedes</span>
                        <strong>{{ booking.guests }}</strong>
                    </div>
                    {% if booking.extraGuestNames %}
                        <div class="admin-detail-row">
                            <span>Hóspedes extra</span>
                            <strong>{{ booking.extraGuestNames|join(', ') }}</strong>
                        </div>
                    {% endif %}
                    <div class="admin-detail-row">
                        <span>Valor da estadia</span>
                        <strong>{% if booking.stayPrice %}R$ {{ booking.stayPrice|number_format(2, ',', '.') }}{% else %}-{% endif %}</strong>
                    </div>
                    <div class="admin-detail-row">
                        <span>Idioma do hóspede</span>
                        <strong>{{ booking.guestLocale == 'en' ? 'English' : 'Português' }}</strong>
                    </div>
                    <div class="admin-detail-row">
                        <span>Origem</span>
                        <strong>{{ booking.source }}</strong>
                    </div>
                    {% if booking.isRajaaram %}
                        <div class="admin-detail-row">
                            <span>Tipo de terapia</span>
                            <strong>{% if booking.rajaaramDuo %}Duo{% else %}Individual{% endif %}</strong>
                        </div>
                        {% for session in booking.rajaaramSessions('pt') %}
                            {% if session.guest or session.therapy or session.date or session.time %}
                                {% if booking.rajaaramDuo or session.guest %}
                                    <div class="admin-detail-row admin-detail-row--subsection">
                                        <span>Terapia {{ loop.index }}</span>
                                        <strong></strong>
                                    </div>
                                {% endif %}
                                {% if session.guest %}
                                    <div class="admin-detail-row">
                                        <span>Nome</span>
                                        <strong>{{ session.guest }}</strong>
                                    </div>
                                {% endif %}
                                {% if session.whatsapp %}
                                    <div class="admin-detail-row">
                                        <span>WhatsApp da terapia</span>
                                        <strong>
                                            {% if session.whatsappUrl %}
                                                <a href="{{ session.whatsappUrl }}" target="_blank" rel="noopener noreferrer">{{ session.whatsapp }}</a>
                                            {% else %}
                                                {{ session.whatsapp }}
                                            {% endif %}
                                        </strong>
                                    </div>
                                {% endif %}
                                {% if session.therapy %}
                                    <div class="admin-detail-row">
                                        <span>Terapia</span>
                                        <strong>{{ session.therapy }}</strong>
                                    </div>
                                {% endif %}
                                {% if session.date %}
                                    <div class="admin-detail-row">
                                        <span>Data da terapia</span>
                                        <strong>{{ session.date }}</strong>
                                    </div>
                                {% endif %}
                                {% if session.time %}
                                    <div class="admin-detail-row">
                                        <span>Horário da terapia</span>
                                        <strong>{{ session.time }}</strong>
                                    </div>
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                        <div class="admin-detail-row">
                            <span>Café da manhã</span>
                            <strong>{% if booking.rajaaramBreakfastIncluded %}Incluído{% elseif booking.rajaaramBreakfastIncluded is same as(false) %}Não incluído{% else %}-{% endif %}</strong>
                        </div>
                    {% endif %}
                    <div class="admin-detail-row">
                        <span>Status</span>
                        <strong><span class="status-pill status-{{ booking.status == 'confirmed' ? 'confirmed' : (booking.status == 'completed' ? 'paid' : 'cancelled') }}">{{ booking.status == 'confirmed' ? 'Confirmada' : (booking.status == 'completed' ? 'Concluída' : 'Cancelada') }}</span></strong>
                    </div>
                    <div class="admin-detail-row">
                        <span>Criada em</span>
                        <strong>{{ booking.createdAt|date('d/m/Y') }}</strong>
                    </div>
                    <div class="admin-detail-row">
                        <span>Último acesso</span>
                        <strong>
                            {% if booking.lastLoginAt %}
                                {{ booking.lastLoginAt|date('d/m/Y H:i') }}
                            {% else %}
                                <span class="admin-muted">Ainda não acedeu</span>
                            {% endif %}
                        </strong>
                    </div>
                    <div class="admin-detail-row">
                        <span>Entradas com código</span>
                        <strong>{{ booking.loginCount }}</strong>
                    </div>
                    {% if booking.googleCalendarSyncedAt %}
                        <div class="admin-detail-row">
                            <span>Google Calendar (estadia)</span>
                            <strong>{{ booking.googleCalendarSyncedAt|date('d/m/Y H:i') }}</strong>
                        </div>
                    {% endif %}
                    {% if rajaaramBusy|length > 0 or rajaaramDrift|length > 0 %}
                        <div class="admin-detail-row admin-detail-row--stack">
                            <span>Terapias · calendário Rajaaram</span>
                            <strong>
                                {% if rajaaramDrift|length > 0 and rajaaramBusy|length > 0 %}
                                    Conteúdo diferente e horário ocupado — use os avisos acima.
                                {% elseif rajaaramDrift|length > 0 %}
                                    Conteúdo diferente do calendário — use o aviso acima para escolher a fonte.
                                {% else %}
                                    Horário ocupado — use o aviso acima para criar o evento ou escolher outro horário.
                                {% endif %}
                            </strong>
                        </div>
                    {% endif %}
                    {% if booking.icalSummary %}
                        <div class="admin-detail-row admin-detail-row--stack">
                            <span>Calendário Airbnb</span>
                            <p>{{ booking.icalSummary }}</p>
                        </div>
                    {% endif %}
                    {% if booking.notes %}
                        <div class="admin-detail-row admin-detail-row--stack">
                            <span>Notas especiais</span>
                            <p>{{ booking.notes|nl2br }}</p>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </section>
    </div>

    {% if isEditing %}
        {{ form_end(form) }}
    {% endif %}

    {% if followUps is defined %}
        {% include 'admin/bookings/_followup_whatsapp.html.twig' with { followUps: followUps } %}
    {% endif %}

    <section class="admin-section admin-section--activity">
        <div class="admin-section-header">
            <h3 class="admin-section-title">Actividade do hóspede</h3>
            <p class="admin-section-desc">Entradas com o código de acesso e secções consultadas no concierge.</p>
        </div>
        {% if activityLogs|length > 0 %}
            <ul class="admin-activity-list">
                {% for log in activityLogs %}
                    <li class="admin-activity-item admin-activity-item--{{ log.type }}">
                        <span class="admin-activity-time">{{ log.createdAt|date('d/m/Y H:i') }}</span>
                        <span class="admin-activity-label">
                            {% if log.type == 'login' %}
                                Entrada com código
                            {% else %}
                                {{ log.label }}
                            {% endif %}
                        </span>
                        {% if log.type == 'page_view' %}
                            <span class="admin-activity-type">Página</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="admin-empty">Nenhuma actividade registada ainda.</p>
        {% endif %}
    </section>

    <section class="admin-section admin-section--extras">
        <div class="admin-section-header">
            <h3 class="admin-section-title">Extras da reserva</h3>
            <p class="admin-section-desc">Gerir extras desta estadia — desactivar extras do catálogo ou adicionar extras personalizados.</p>
        </div>

        {% if availableExtras|length > 0 %}
            <div class="admin-extra-availability">
                <h4 class="admin-subsection-title">Disponibilidade para o hóspede</h4>
                <p class="admin-section-desc">Desactive extras que este hóspede não deve ver ou solicitar na concierge.</p>
                <ul class="admin-extra-toggle-list">
                    {% for extra in availableExtras %}
                        {% set isDisabled = extra.id in disabledExtraIds %}
                        <li class="admin-extra-toggle-item{% if isDisabled %} is-disabled{% endif %}">
                            <span class="admin-extra-toggle-label">
                                {{ extra.namePt }}
                                <span class="admin-extra-toggle-meta">{% if extra.price > 0 %}R$ {{ extra.price|number_format(2, ',', '.') }}{% else %}Grátis{% endif %}</span>
                            </span>
                            <form method="post" action="{{ path('admin_booking_toggle_extra', {id: booking.id}) }}">
                                {{ csrf.csrf() }}
                                <input type="hidden" name="extraId" value="{{ extra.id }}">
                                <button type="submit" class="btn btn-sm {% if isDisabled %}btn-outline{% else %}btn-accent{% endif %}">
                                    {% if isDisabled %}Activar{% else %}Desactivar{% endif %}
                                </button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <h4 class="admin-subsection-title">Extras atribuídos</h4>
        {% for be in bookingExtras %}
            <div class="admin-extra-item">
                <div class="admin-extra-item-head">
                    <strong>
                        {{ be.displayName }}
                        {% if be.custom %}<span class="admin-extra-badge">Personalizado</span>{% endif %}
                    </strong>
                    <span class="status-pill status-{{ be.status }}">{{ be.status }}</span>
                </div>
                {% if be.priceAtBooking is not null %}
                    <p class="admin-extra-price">
                        {% if be.priceAtBooking == 0 %}Grátis{% else %}R$ {{ (be.priceAtBooking * be.quantity)|number_format(2, ',', '.') }}{% endif %}
                        {% if be.quantity > 1 %}<span class="admin-extra-qty">× {{ be.quantity }}</span>{% endif %}
                    </p>
                {% endif %}
                {% if be.notes %}<p class="admin-extra-notes">{{ be.notes }}</p>{% endif %}
                <div class="admin-extra-actions">
                    {% for status in ['requested', 'paid', 'confirmed', 'cancelled'] %}
                        <form method="post" action="{{ path('admin_booking_extra_status', {id: booking.id, extraId: be.id}) }}">
                            {{ csrf.csrf() }}
                            <input type="hidden" name="status" value="{{ status }}">
                            <button type="submit" class="btn btn-outline btn-sm">{{ status }}</button>
                        </form>
                    {% endfor %}
                    <form method="post" action="{{ path('admin_booking_extra_delete', {id: booking.id, extraId: be.id}) }}">
                        {{ csrf.csrf() }}
                        <button type="submit" class="btn btn-outline btn-sm">✕</button>
                    </form>
                </div>
            </div>
        {% else %}
            <p class="admin-empty">Nenhum extra nesta reserva.</p>
        {% endfor %}

        {% if availableExtras|length > 0 %}
            <form method="post" action="{{ path('admin_booking_add_extra', {id: booking.id}) }}" class="admin-add-extra-form">
                {{ csrf.csrf() }}
                <h4 class="admin-subsection-title">Adicionar extra do catálogo</h4>
                <div class="form-group">
                    <label for="extraId">Extra</label>
                    <select id="extraId" name="extraId" required>
                        <option value="">Selecionar extra...</option>
                        {% for extra in availableExtras %}
                            <option value="{{ extra.id }}">{{ extra.namePt }}, {% if extra.price > 0 %}R$ {{ extra.price|number_format(2, ',', '.') }}{% else %}Grátis{% endif %}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="admin-add-extra-row">
                    <div class="form-group">
                        <label for="extraQty">Qtd.</label>
                        <input id="extraQty" type="number" name="quantity" value="1" min="1">
                    </div>
                    <div class="form-group admin-add-extra-notes">
                        <label for="extraNotes">Notas</label>
                        <input id="extraNotes" type="text" name="notes" placeholder="Observações (opcional)">
                    </div>
                    <button type="submit" class="btn btn-accent btn-sm admin-add-extra-btn">+ Adicionar</button>
                </div>
            </form>
        {% else %}
            <p class="admin-empty" style="margin-top:1rem">Nenhum extra activo disponível. <a href="{{ path('admin_extras') }}">Gerir extras →</a></p>
        {% endif %}

        <form method="post" action="{{ path('admin_booking_add_custom_extra', {id: booking.id}) }}" class="admin-add-extra-form admin-add-custom-extra-form">
            {{ csrf.csrf() }}
            <h4 class="admin-subsection-title">Adicionar extra personalizado</h4>
            <p class="admin-section-desc">Crie um extra só para este hóspede — aparece confirmado na concierge.</p>
            <div class="admin-add-extra-row">
                <div class="form-group">
                    <label for="customNamePt">Nome (PT)</label>
                    <input id="customNamePt" type="text" name="customNamePt" placeholder="Ex.: Massagem especial">
                </div>
                <div class="form-group">
                    <label for="customNameEn">Nome (EN)</label>
                    <input id="customNameEn" type="text" name="customNameEn" placeholder="Optional">
                </div>
            </div>
            <div class="admin-add-extra-row">
                <div class="form-group">
                    <label for="customPrice">Preço (R$)</label>
                    <input id="customPrice" type="number" name="price" value="0" min="0" step="0.01">
                </div>
                <div class="form-group">
                    <label for="customQty">Qtd.</label>
                    <input id="customQty" type="number" name="quantity" value="1" min="1">
                </div>
                <div class="form-group admin-add-extra-notes">
                    <label for="customNotes">Notas</label>
                    <input id="customNotes" type="text" name="notes" placeholder="Observações (opcional)">
                </div>
                <button type="submit" class="btn btn-accent btn-sm admin-add-extra-btn">+ Adicionar personalizado</button>
            </div>
        </form>
    </section>
</div>

<textarea id="guest-welcome-message" hidden>{{ guestWelcomeMessage }}</textarea>

<script>
document.querySelectorAll('[data-copy-code], [data-copy-target], [data-copy-text]').forEach((btn) => {
    btn.addEventListener('click', async () => {
        const text = btn.dataset.copyText
            ?? btn.dataset.copyCode
            ?? document.querySelector(btn.dataset.copyTarget)?.value;
        if (!text) return;

        const original = btn.textContent;
        try {
            await navigator.clipboard.writeText(text);
            btn.textContent = 'Copiado!';
            setTimeout(() => { btn.textContent = original; }, 2000);
        } catch (_) {}
    });
});

document.querySelectorAll('[data-followups]').forEach((root) => {
    const buttons = root.querySelectorAll('[data-followup-lang]');
    const setLocale = (locale) => {
        root.dataset.followupLocale = locale;
        buttons.forEach((btn) => {
            btn.classList.toggle('is-active', btn.getAttribute('data-followup-lang') === locale);
        });
        root.querySelectorAll('[data-followup-panel]').forEach((panel) => {
            panel.hidden = panel.getAttribute('data-followup-panel') !== locale;
        });
    };
    buttons.forEach((btn) => {
        btn.addEventListener('click', () => setLocale(btn.getAttribute('data-followup-lang') || 'pt'));
    });
});
</script>
{% endblock %}
