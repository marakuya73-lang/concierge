<section class="admin-rajaaram-section" data-booking-form-target="rajaaramSection"{% if form.source.vars.data != constant('App\\Entity\\Booking::SOURCE_RAJAARAM') %} hidden{% endif %}>
    <div class="admin-section-header" style="margin-top:1.5rem">
        <h3 class="admin-section-title">Jornada Rajaaram</h3>
        <p class="admin-section-desc">Terapia e café da manhã incluídos na estadia. Quem faz a terapia pode ser diferente de quem reservou.</p>
    </div>

    {{ form_row(form.rajaaramIsDuo) }}

    <div class="admin-rajaaram-therapy-block" data-booking-form-target="rajaaramGuest1Block">
        <p class="admin-subsection-label" data-booking-form-target="rajaaramGuest1Label">Terapia</p>
        {{ form_row(form.rajaaramGuest1Name) }}
        {{ form_row(form.rajaaramGuest1Whatsapp) }}
        <div class="form-row-2">
            {{ form_row(form.rajaaramTherapy) }}
            {{ form_row(form.rajaaramTherapyDate) }}
        </div>
        {{ form_row(form.rajaaramTherapyTime) }}
    </div>

    <div class="admin-rajaaram-therapy-block admin-rajaaram-duo-block" data-booking-form-target="rajaaramDuoSection"{% if not form.rajaaramIsDuo.vars.data %} hidden{% endif %}>
        <p class="admin-subsection-label">Terapia 2</p>
        {{ form_row(form.rajaaramGuest2Name) }}
        {{ form_row(form.rajaaramGuest2Whatsapp) }}
        <div class="form-row-2">
            {{ form_row(form.rajaaramTherapy2) }}
            {{ form_row(form.rajaaramTherapy2Date) }}
        </div>
        {{ form_row(form.rajaaramTherapy2Time) }}
    </div>

    {{ form_row(form.rajaaramBreakfastIncluded) }}
</section>
