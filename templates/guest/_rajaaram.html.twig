{% macro rajaaram_experience(firstName, rajaaram) %}
    <section class="rajaaram-experience" aria-labelledby="rajaaram-welcome-title">
        <div class="rajaaram-welcome">
            <p class="rajaaram-kicker">{{ 'app.rajaaram_journey_title'|trans }}</p>
            <h2 id="rajaaram-welcome-title" class="rajaaram-welcome-title font-serif">
                {{ 'app.rajaaram_welcome_title'|trans({'%name%': firstName}) }}
            </h2>
            <p class="rajaaram-welcome-lead">{{ 'app.rajaaram_welcome_lead'|trans }}</p>
        </div>

        <div class="rajaaram-session">
            <p class="rajaaram-session-label">{{ 'app.rajaaram_session_label'|trans }}</p>
            {% for session in rajaaram.sessions %}
                {% if session.guest or session.therapy or session.date or session.time %}
                    <article class="rajaaram-journey-card">
                        <p class="rajaaram-journey-kicker">{{ 'app.rajaaram_guest_number'|trans({'%number%': loop.index}) }}</p>
                        {% if session.guest %}
                            <h3 class="rajaaram-journey-name font-serif">{{ session.guest }}</h3>
                        {% endif %}
                        {% if session.therapy %}
                            <p class="rajaaram-journey-ceremony-label">{{ 'app.rajaaram_therapy'|trans }}</p>
                            <p class="rajaaram-journey-ceremony font-serif">{{ session.therapy }}</p>
                        {% endif %}
                        {% if session.date or session.time %}
                            <p class="rajaaram-journey-when">
                                {% if session.date %}<span>{{ session.date }}</span>{% endif %}
                                {% if session.date and session.time %}<span class="rajaaram-journey-dot" aria-hidden="true">·</span>{% endif %}
                                {% if session.time %}<span>{{ session.time }}</span>{% endif %}
                            </p>
                        {% endif %}
                    </article>
                {% endif %}
            {% endfor %}
            {% if rajaaram.breakfastIncluded is same as(true) or rajaaram.breakfastIncluded is same as(false) %}
                <p class="rajaaram-journey-breakfast">
                    {{ 'app.rajaaram_breakfast_label'|trans }}
                    ·
                    {% if rajaaram.breakfastIncluded is same as(true) %}
                        {{ 'app.rajaaram_breakfast_included'|trans }}
                    {% else %}
                        {{ 'app.rajaaram_breakfast_not_included'|trans }}
                    {% endif %}
                </p>
            {% endif %}
        </div>

        <div class="rajaaram-recommendations">
            <header class="rajaaram-recommendations-header">
                <div class="rajaaram-recommendations-heading">
                    <p class="rajaaram-recommendations-kicker">{{ 'app.rajaaram_recommendations_kicker'|trans }}</p>
                    <h3 class="rajaaram-recommendations-title font-serif">{{ 'app.rajaaram_recommendations_title'|trans }}</h3>
                </div>
                <span class="rajaaram-24h-badge">{{ 'app.rajaaram_24h_badge'|trans }}</span>
            </header>
            <p class="rajaaram-recommendations-intro">{{ 'app.rajaaram_recommendations_intro'|trans }}</p>

            <ol class="rajaaram-rec-list">
                <li class="rajaaram-rec-card">
                    <span class="rajaaram-rec-num" aria-hidden="true">01</span>
                    <div class="rajaaram-rec-copy">
                        <h4 class="rajaaram-rec-title">{{ 'app.rajaaram_rec_abstinence_title'|trans }}</h4>
                        <p class="rajaaram-rec-text">{{ 'app.rajaaram_rec_abstinence_text'|trans }}</p>
                    </div>
                </li>
                <li class="rajaaram-rec-card">
                    <span class="rajaaram-rec-num" aria-hidden="true">02</span>
                    <div class="rajaaram-rec-copy">
                        <h4 class="rajaaram-rec-title">{{ 'app.rajaaram_rec_diet_title'|trans }}</h4>
                        <p class="rajaaram-rec-text">{{ 'app.rajaaram_rec_diet_text'|trans }}</p>
                    </div>
                </li>
                <li class="rajaaram-rec-card">
                    <span class="rajaaram-rec-num" aria-hidden="true">03</span>
                    <div class="rajaaram-rec-copy">
                        <h4 class="rajaaram-rec-title">{{ 'app.rajaaram_rec_mental_title'|trans }}</h4>
                        <p class="rajaaram-rec-text">{{ 'app.rajaaram_rec_mental_text'|trans }}</p>
                    </div>
                </li>
                <li class="rajaaram-rec-card">
                    <span class="rajaaram-rec-num" aria-hidden="true">04</span>
                    <div class="rajaaram-rec-copy">
                        <h4 class="rajaaram-rec-title">{{ 'app.rajaaram_rec_health_title'|trans }}</h4>
                        <p class="rajaaram-rec-text">{{ 'app.rajaaram_rec_health_text'|trans }}</p>
                    </div>
                </li>
            </ol>

            <aside class="rajaaram-rec-notice">
                <p>{{ 'app.rajaaram_rec_skincare'|trans }}</p>
            </aside>

            <p class="rajaaram-rec-closing">{{ 'app.rajaaram_rec_closing'|trans }}</p>
        </div>
    </section>
{% endmacro %}
