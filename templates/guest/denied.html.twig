{% extends 'base.html.twig' %}

{% block title %}{{ 'app.access_denied'|trans }} | Domo Xangô{% endblock %}

{% block body %}
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center">
    <div class="container" style="text-align:center">
        <div style="font-size:2.5rem;margin-bottom:1rem;opacity:.2">🔒</div>
        <h2 class="font-serif" style="font-size:1.75rem">{{ 'app.access_denied'|trans }}</h2>
        <p style="color:var(--muted-foreground);font-size:.875rem">{{ error }}</p>
        <a href="{{ path('guest_home') }}" class="btn btn-primary" style="margin-top:1.5rem">{{ 'app.back'|trans }}</a>
    </div>
</div>
{% endblock %}
