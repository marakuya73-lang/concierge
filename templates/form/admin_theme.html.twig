{% use "form_div_layout.html.twig" %}

{%- block form_row -%}
    {%- set row_class = 'form-group' -%}
    {%- if expanded is defined and expanded and not multiple -%}
        {%- set row_class = row_class ~ ' form-group--radios' -%}
    {%- endif -%}
    {%- set row_attr = row_attr|merge({class: (row_attr.class|default('') ~ ' ' ~ row_class)|trim}) -%}
    {%- set attr = {} -%}
    {%- set aria_describedby = [] -%}
    {%- if help -%}
        {%- set aria_describedby = aria_describedby|merge([id ~ '_help']) -%}
    {%- endif -%}
    {%- if errors|length > 0 -%}
        {%- set aria_describedby = aria_describedby|merge(errors|map((_, index) => id ~ '_error' ~ (index + 1))) -%}
    {%- endif -%}
    {%- if aria_describedby|length > 0 -%}
        {%- set attr = attr|merge({'aria-describedby': aria_describedby|join(' ')}) -%}
    {%- endif -%}
    {%- if errors|length > 0 -%}
        {%- set attr = attr|merge({'aria-invalid': 'true'}) -%}
    {%- endif -%}
    {%- set widget_attr = {attr: attr} -%}
    {{- block('form_row_render') -}}
{%- endblock form_row -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="form-errors">
            {%- for error in errors -%}
                <li>{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors -%}

{%- block checkbox_widget -%}
    <input type="checkbox" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} />
{%- endblock checkbox_widget -%}

{%- block checkbox_row -%}
    {%- set row_attr = row_attr|merge({class: (row_attr.class|default('') ~ ' form-group form-group--checkbox')|trim}) -%}
    <div{% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        {{- form_widget(form) -}}
        {{- form_label(form) -}}
        {{- form_errors(form) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block choice_widget_expanded -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-radios')|trim}) -%}
    <div {{ block('widget_container_attributes') }}>
        {%- for child in form %}
            <label class="form-radio"{% if child.vars.id %} for="{{ child.vars.id }}"{% endif %}>
                {{- form_widget(child) -}}
                <span>{{ child.vars.label }}</span>
            </label>
        {%- endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}
